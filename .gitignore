# Extracted third-party DSH packages kept only as reading material while
# developing the plugin. They are not mine to redistribute, and they can be
# regenerated with tools/asar-extract.mjs at any time.
refs/

# Scratch output from the DOM probe / harness runs.
tmp/

# Never commit installed dependencies or logs.
node_modules/
*.log

# Temporary bridge: the running DSH host caches a plugin's resolved package path
# until it restarts, and this repository used to live in dsh-code-marks/. This
# mirror keeps that cached path resolvable so the plugin keeps working in the
# current session. Safe to delete after the next DSH restart.
dsh-code-marks/
